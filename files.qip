# TG68K.C, the 68EC020 main CPU. Vendored -- see rtl/cpu/tg68k/PROVENANCE.md.
# Package FIRST: Quartus resolves it at analysis time, like ModelSim.
# TG68K.vhd is deliberately absent. It is the async-68000-bus wrapper, not the
# CPU, and this project instantiates TG68KdotC_Kernel directly. It stays in the
# tree as the reference for what the kernel's bus expects.
set_global_assignment -name VHDL_FILE rtl/cpu/tg68k/TG68K_Pack.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/tg68k/TG68K_ALU.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/tg68k/TG68KdotC_Kernel.vhd

# K053246/K055673, the sprite generator at 0xd20000/0xd48000/0xd4a000.
# Vendored -- see rtl/video/k055673/PROVENANCE.md; three files carry GX changes.
# jtsimson_obj.v is listed but not used by GX (rtl/video/gx_obj.v is).
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/k055673/jt053246.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/k055673/jt053246_scan.sv
set_global_assignment -name VERILOG_FILE rtl/video/k055673/jt053246_dma.v
set_global_assignment -name VERILOG_FILE rtl/video/k055673/jt053246_mmr.v
set_global_assignment -name VERILOG_FILE rtl/video/k055673/jtsimson_obj.v

# K054156/K056832, the tilemap generator at 0xd40000/0xda0000. Vendored --
# see rtl/video/k056832/PROVENANCE.md. The *_mmr files are generated by
# `jtframe mmr -m jt05415x`; regenerate rather than hand-edit.
set_global_assignment -name VERILOG_FILE rtl/video/k056832/jt05415x.v
set_global_assignment -name VERILOG_FILE rtl/video/k056832/jt054156_mmr.v
set_global_assignment -name VERILOG_FILE rtl/video/k056832/jt054157_mmr.v

# K053252, the CRTC and interrupt generator at 0xd4c000. Vendored from
# jotego/jtcores -- see rtl/video/k053252/PROVENANCE.md. jtk053252_mmr.v is
# generated by `jtframe mmr rungun`; regenerate rather than hand-edit.
set_global_assignment -name VERILOG_FILE rtl/video/k053252/jtk053252.v
set_global_assignment -name VERILOG_FILE rtl/video/k053252/jtk053252_mmr.v

# CRT Adjust: rmonic79's crt_adjust.sv and crt_vsize.sv (GPL-3, vendored by
# way of Arcade-Psikyo_MiSTer; THIRD-PARTY.md) and this project's glue.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/crt/crt_vsize.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/crt/crt_adjust.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/gx_crt_chain.sv

# This project's own video RTL. gx_obj.v is derived from jotego's
# jtsimson_obj.v -- see rtl/video/k055673/PROVENANCE.md, "Local changes".
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/gx_sdpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/gx_tdpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/gx_tilemap.sv
set_global_assignment -name VERILOG_FILE rtl/video/gx_obj.v
set_global_assignment -name VERILOG_FILE rtl/video/gx_obj_linebuf.v
set_global_assignment -name VERILOG_FILE rtl/video/gx_mixer.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/gx_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/screen_rotate_two.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/fx68k/fx68k.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/fx68k/fx68kAlu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/fx68k/uaddrPla.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/gx_k056800.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/gx_k054539.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/gx_tms57002.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/gx_snd_clear.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sound/gx_sound.sv

# jtframe primitives the vendored chip modules instantiate -- see
# rtl/jtframe/PROVENANCE.md. Bench-only jtframe files live in sim/jtframe_ver/
# and are deliberately absent here.
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_edge.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_count_ld.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_ff_jk.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_dual_ram.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_dual_nvram.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_dual_ram16.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_dual_nvram16.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_8x8x4_packed_msb.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_obj_buffer.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_objdraw.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_objdraw_gate.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_draw.v

# K054338, the alpha blender at 0xd80000. Vendored from jotego/jtcores --
# see rtl/video/k054338/PROVENANCE.md.
set_global_assignment -name VERILOG_FILE rtl/video/k054338/jt054338.v

# The main board and the MiSTer side of it.
set_global_assignment -name VERILOG_FILE rtl/gx_eeprom93c46.v
set_global_assignment -name VERILOG_FILE rtl/gx_esc.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx_keyboard.sv
set_global_assignment -name VERILOG_FILE rtl/hiscore/hiscore.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx_guns.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/gx_romcache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx_main.sv

# Save states (docs/SAVESTATES.md): the engine, the CPUs' register access
# through their buses, and the modules' state-bus shadows.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx_ss_vec.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/gx_ss_m68k.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx_savestate.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx_ss_ddr.sv

# Cheats: wickerwaka's read-override engine (rtl/cheat/PROVENANCE.md).
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cheat/cheatengine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gx_board_cfg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/debug/issp_probe.sv

# SDRAM: Sorgelig's controller with the burst-4 reads, the phy, arbiter and
# download from Arcade-Seta_MiSTer (rtl/memory/sdram/PROVENANCE.md); the
# image, the clock crossing and the ROM-row spreading are this project's.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/sdram/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/sdram_arbiter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/sdram_download.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/ddram_phy.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/gx_rom_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/gx_rom_port.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/gx_sdram_top.sv

set_global_assignment -name QIP_FILE rtl/pll/pll_0002.qip
set_global_assignment -name VERILOG_FILE rtl/pll/pll_0002.v
set_global_assignment -name VERILOG_FILE rtl/pll.v
set_global_assignment -name SDC_FILE KonamiGX.sdc
set_global_assignment -name SYSTEMVERILOG_FILE KonamiGX.sv
