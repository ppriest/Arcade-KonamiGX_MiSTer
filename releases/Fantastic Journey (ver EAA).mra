<misterromdescription>
    <name>Fantastic Journey (ver EAA)</name>
    <setname>fantjour</setname>
    <rbf>KonamiGX</rbf>
    <year>1994</year>
    <manufacturer>Konami</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <rom index="1"><part>03</part></rom>

    <!-- the SDRAM image rtl/memory/gx_sdram_top.sv expects for this set
         (rtl/gx_board_cfg.sv arm 3); written and proven by
         scripts/build_mra.py, not by hand -->
    <rom index="0" zip="fantjour.zip|konamigx.zip" md5="none" address="0x30000000">
        <!-- maincpu, the CPU's window packed: BIOS, then 0x200000.. moved down by 0x1e0000 -->
        <part name="300a01.34k" crc="d5fa95f5"/>
        <interleave output="32">
            <part name="321eaa04.27b" crc="b2cfe225" map="0012"/>
            <part name="321eaa02.21b" crc="afaf9d17" map="1200"/>
        </interleave>
        <part repeat="2">00</part>
        <!-- k056832: the four-byte part of each 5-byte row, then the fifth bytes (the core spreads rows to 8) -->
        <part repeat="917502">00</part>
        <part name="321b14.17h" crc="437d0057"/>  <!-- four-byte part -->
        <part repeat="2936012">00</part>
        <part name="321b12.13g" crc="5f9edfa0"/>  <!-- fifth bytes -->
        <part repeat="734003">00</part>
        <!-- k055673: MAME's region, a four-byte part then the fifth bytes -->
        <part repeat="4194305">00</part>
        <interleave output="32">
            <part name="321b11.25g" crc="c6e2e74d" map="0021"/>
            <part name="321b10.28g" crc="ea9f8c48" map="2100"/>
        </interleave>
        <part name="321b09.30g" crc="94add237"/>
    </rom>

    <!-- the default EEPROM image (the ROM_START eeprom region); the core loads it into the 93C46 -->
    <rom index="2" zip="fantjour.zip" md5="none">
        <part name="fantjour.nv"/>
    </rom>

    <switches default="FE,FF">
        <dip name="Sound Output" bits="0" ids="Stereo,Mono"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
    </switches>

    <buttons names="Button 1,Button 2,Button 3,-,-,-,Start,Coin,Pause,Service" default="A,B,X,Start,Select,L,R" count="3"/>
</misterromdescription>
