set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY gx_tilemap_synth_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name SEED 1
set_global_assignment -name SYSTEMVERILOG_FILE ../../video/gx_sdpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../video/gx_tilemap.sv
set_global_assignment -name SYSTEMVERILOG_FILE gx_tilemap_synth_top.sv
set_global_assignment -name SDC_FILE gx_tilemap_synth.sdc
# Virtual pins: the pad ring must not enter the measurement.
set_instance_assignment -name VIRTUAL_PIN ON -to sdi
set_instance_assignment -name VIRTUAL_PIN ON -to ld
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_instance_assignment -name VIRTUAL_PIN ON -to sig[*]

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"